{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "files": {
    "includes": [
      "core/src/**",
      "core/test/**",
      "widget/src/src/**",
      "widget/build.js",
      "widget/test/**",
      "wasm/build.js",
      "wasm/test/**",
      "capd/src/**",
      "capd/test/**",
      "capd/dashboard/src/**",
      "capd/vite.config.mjs",
      "demo-dashboard/src/**",
      "demo-dashboard/vite.config.mjs",
      "!**/node_modules",
      "!**/cap_wasm.js",
      "!**/cap_wasm_bg.wasm.d.ts",
      "!**/.data",
      "!**/data",
      "!**/dist",
      "!widget/test/fixtures",
      "!widget/test/legacy",
      "!widget/src/cap.min.js",
      "!widget/src/cap-floating.min.js",
      "!widget/src/wasm-hashes.min.js",
      "!widget/src/src/cap.js",
      "!capd/dashboard/src/styles/capui/utilities.css"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "useConst": "error"
      },
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["widget/src/src/cap.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          },
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["capd/dashboard/src/**/*.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          },
          "suspicious": {
            "noDuplicateProperties": "off"
          }
        }
      }
    },
    {
      "includes": ["capd/dashboard/src/lib/api.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
