{
  "name": "capd",
  "version": "4.0.9",
  "imports": {
    "#platform": {
      "workerd": "./src/workers/platform.js",
      "default": "./src/platform.js"
    },
    "#db": {
      "workerd": "./src/workers/db.js",
      "default": "./src/db.js"
    },
    "#ipdb": {
      "workerd": "./src/workers/ipdb.js",
      "default": "./src/ipdb.js"
    },
    "#live": {
      "workerd": "./src/workers/live.js",
      "default": "./src/live.js"
    },
    "#static": {
      "workerd": "./src/workers/static.js",
      "default": "./src/static.js"
    },
    "#event-store": {
      "workerd": "./src/workers/event-store.js",
      "default": "./src/events/open-store.js"
    }
  },
  "keywords": [
    "algorithm",
    "anti-abuse",
    "anti-automation",
    "anti-bot",
    "anti-ddos",
    "anti-dos",
    "anti-exploitation",
    "anti-scraping",
    "anti-spam",
    "attack-mitigation",
    "bots",
    "captcha-alternative",
    "client-server",
    "complexity",
    "computational-puzzle",
    "crypto",
    "cryptographic",
    "cybersecurity",
    "ddos",
    "defense",
    "detection",
    "filtering",
    "hashcash",
    "hcaptcha",
    "invisible",
    "pow",
    "prevention",
    "proof-of-work",
    "protection",
    "protocol",
    "recaptcha",
    "security",
    "spam",
    "turing-test",
    "verification"
  ],
  "module": "src/index.js",
  "capAssets": {
    "widget": "0.1.62",
    "wasm": "0.0.8"
  },
  "scripts": {
    "test": "bun test",
    "build": "vite build",
    "dev": "vite build && bun run --watch src/index.js",
    "dev:ui": "vite",
    "docker:build": "cd .. && docker build -f capd/Dockerfile -t capd:local .",
    "docker:up": "docker compose up -d",
    "docker:up:duckdb": "docker compose -f docker-compose.duckdb.yml up -d",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build --watch",
    "docker:publish": "cd .. && docker buildx build --platform linux/amd64,linux/arm64 -t tiago2/cap:4.0.9 -t tiago2/cap:4.0 -t tiago2/cap:4 -t tiago2/cap:latest -f capd/Dockerfile . --push"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@elysiajs/swagger": "^1.3.1",
    "capjs-core": "^0.1.15",
    "elysia": "^1.4.28",
    "maxmind": "^5.0.6",
    "re2js": "2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "bits-ui": "2.20.6",
    "bun-types": "^1.3.12",
    "chart.js": "4.5.0",
    "clsx": "2.1.1",
    "svelte": "5.57.3",
    "tailwind-merge": "3.5.0",
    "tailwind-variants": "4.0.1",
    "tailwindcss": "4.3.5",
    "topojson-client": "3.1.0",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.6"
  }
}
