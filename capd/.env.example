# Copy this file to .env next to the compose file and set ADMIN_KEY.
# Everything else Cap needs is set in the dashboard.

# Password for the dashboard and the admin API, at least 12 characters.
# The ClickHouse compose file also puts it in the ClickHouse URL as the
# password, so with that file stick to letters and digits.
# Generate one with: openssl rand -hex 24
# Wrap it in single quotes if it has spaces, # or $.
ADMIN_KEY=

# Valkey connection string. Both compose files set it to redis://valkey:6379.
# Redis works too. REDIS_URL is read as an alias.
VALKEY_URL=

# For Valkey over TLS with a self-signed certificate, use a rediss:// URL and
# point this at the CA certificate in PEM format. VALKEY_TLS_CERT and
# VALKEY_TLS_KEY add a client certificate when the server asks for one.
VALKEY_TLS_CA=

# Store analytics events in your own ClickHouse instead of DuckDB, for example
# http://cap:password@clickhouse.internal:8123/cap. The user defaults to default
# and the database to cap. Write the password as it is, without URL encoding.
# The ClickHouse compose file sets this for you.
CLICKHOUSE_URL=

# Set to true to let webhooks post to loopback, private and link-local addresses.
# It stays off unless you set it here, so a stolen dashboard session can't reach
# services that are only meant for this network.
WEBHOOK_ALLOW_PRIVATE=false

# Docker Compose only. Image to run, pin a version such as tiago2/cap:4.0.0 for
# predictable upgrades, and the host port Cap is published on.
CAP_IMAGE=tiago2/cap:4
CAP_PORT=3000
